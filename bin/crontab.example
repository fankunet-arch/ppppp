# ════════════════════════════════════════════════════════════
# 会员积分系统 —— crontab 示例
#
# 时段依据（实测 88,616 单的 order_end_time 分布）：
#   午市 13:00–17:00（峰值 16 点 22,875 单）
#   晚市 20:00–01:00（峰值 22 点 14,612 单）
#   02:00–10:00 全时段 0 单  ← 唯一绝对安全的窗口
#
# 装载：crontab -u www-data bin/crontab.example
# ════════════════════════════════════════════════════════════

PATH=/usr/local/bin:/usr/bin:/bin
VIP=/opt/vip

# ── 增量补抓 ────────────────────────────────────────────────
# 仅营业时段，每 20 分钟。带并发锁，上轮没跑完会自动跳过。
*/20 11-23,0-1 * * *  php $VIP/bin/cron.php incremental >> $VIP/var/log/cron.log 2>&1

# ── 夜间全套 ────────────────────────────────────────────────
# 03:15 —— 落在 03:00–05:00 的安全窗口内。
# 含：增量补抓 → 值比对冲正 → 完整性监控 → 规则表巡检 → 合规到期 → 会话清理
15 3 * * *  php $VIP/bin/cron.php nightly -v >> $VIP/var/log/cron.log 2>&1

# ── 状态巡检（可选）────────────────────────────────────────
# 每天 09:00 把水位线与未处理告警打到日志，便于早班查看
0 9 * * *  php $VIP/bin/cron.php status >> $VIP/var/log/cron-status.log 2>&1
